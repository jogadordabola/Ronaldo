<ui:FluentWindow x:Class="ronaldo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Ronaldo LoL Companion" Icon="Assets/ronaldo.ico"
        Height="880" Width="1240" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Purple-grey palette -->
        <SolidColorBrush x:Key="BgWindow"   Color="#14111B"/>
        <SolidColorBrush x:Key="BgPanel"    Color="#1B1725"/>
        <SolidColorBrush x:Key="BgCard"     Color="#221D30"/>
        <SolidColorBrush x:Key="BgCardHot"  Color="#2A2340"/>
        <SolidColorBrush x:Key="BgCardOn"   Color="#2F2649"/>
        <SolidColorBrush x:Key="BgInset"    Color="#1A1626"/>
        <SolidColorBrush x:Key="Divider"    Color="#322B47"/>
        <SolidColorBrush x:Key="Edge"       Color="#2C2640"/>
        <SolidColorBrush x:Key="EdgeOn"     Color="#9F7AEA"/>

        <SolidColorBrush x:Key="TextHi"     Color="#F0EDF7"/>
        <SolidColorBrush x:Key="TextMid"    Color="#B8B0CC"/>
        <SolidColorBrush x:Key="TextLo"     Color="#7C7496"/>

        <SolidColorBrush x:Key="Violet"     Color="#9F7AEA"/>
        <SolidColorBrush x:Key="VioletLt"   Color="#C9B6F5"/>
        <SolidColorBrush x:Key="Lilac"      Color="#D9BFF5"/>
        <SolidColorBrush x:Key="Periwinkle" Color="#A5B0F0"/>
        <SolidColorBrush x:Key="Mint"       Color="#8FD9BC"/>
        <SolidColorBrush x:Key="Amber"      Color="#E8C68A"/>

        <Style x:Key="Caption" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption"/>
            <Setter Property="Foreground" Value="{StaticResource TextLo}"/>
        </Style>

        <!-- Glow behind the filter dropdowns so they don't read as default controls -->
        <Style x:Key="GlowBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#9F7AEA" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#B794F6" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A row of icons with names in tooltips -->
        <DataTemplate x:Key="IconTemplate">
            <Border Margin="0,0,4,0" CornerRadius="4" ToolTip="{Binding Name}">
                <Image Source="{Binding Source}" Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SmallIconTemplate">
            <Border Margin="0,0,3,3" CornerRadius="4" ToolTip="{Binding Name}">
                <Image Source="{Binding Source}" Width="24" Height="24"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- One row of an expanded match scoreboard -->
        <DataTemplate x:Key="ScoreboardRowTemplate">
            <Border CornerRadius="6" Padding="8,5" Margin="0,0,0,4" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1E1929"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgCardOn}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource EdgeOn}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="4" Width="30" Height="30"
                            ClipToBounds="True" Background="#191324">
                        <Image Source="{Binding ChampionIcon}" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding Name}" FontTypography="Caption"
                                      Foreground="{StaticResource TextHi}"
                                      TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock Text="{Binding ChampionName}" Style="{StaticResource Caption}"
                                      TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="76">
                        <ui:TextBlock Text="{Binding KdaText}" FontTypography="Caption"
                                      Foreground="{StaticResource TextHi}"/>
                        <ui:TextBlock Text="{Binding CsText}" Style="{StaticResource Caption}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="70">
                        <ui:TextBlock Text="{Binding DamageText}" Style="{StaticResource Caption}"
                                      Foreground="{StaticResource Lilac}"/>
                        <ui:TextBlock Text="{Binding LevelText}" Style="{StaticResource Caption}"/>
                    </StackPanel>

                    <ItemsControl Grid.Column="4" ItemsSource="{Binding Items}"
                                  VerticalAlignment="Center"
                                  ItemTemplate="{StaticResource SmallIconTemplate}"
                                  ItemsPanel="{StaticResource RowPanel}" Width="196"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A match in the history list; clicking it reveals the full scoreboard -->
        <DataTemplate x:Key="MatchTemplate">
            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderThickness="1"
                    Background="{StaticResource BgCard}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Won}" Value="True">
                                <Setter Property="BorderBrush" Value="#2E6B55"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Won}" Value="False">
                                <Setter Property="BorderBrush" Value="#6B3340"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Match_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="6" Width="44" Height="44"
                                ClipToBounds="True" Background="#191324">
                            <Image Source="{Binding ChampionIcon}" Width="44" Height="44"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center" Width="118">
                            <ui:TextBlock Text="{Binding ResultText}" FontTypography="BodyStrong">
                                <ui:TextBlock.Style>
                                    <Style TargetType="ui:TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Mint}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Won}" Value="False">
                                                <Setter Property="Foreground" Value="#F0A0A8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>
                            <ui:TextBlock Text="{Binding ChampionName}" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource Lilac}"/>
                            <ui:TextBlock Text="{Binding QueueText}" Style="{StaticResource Caption}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="110">
                            <ui:TextBlock Text="{Binding KdaText}" FontTypography="BodyStrong"
                                          Foreground="{StaticResource TextHi}"/>
                            <ui:TextBlock Text="{Binding RatioText}" Style="{StaticResource Caption}"/>
                            <ui:TextBlock Text="{Binding CsText}" Style="{StaticResource Caption}"/>
                        </StackPanel>

                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Items}"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                      ItemTemplate="{StaticResource SmallIconTemplate}"
                                      ItemsPanel="{StaticResource RowPanel}" MaxWidth="230"/>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:TextBlock Text="{Binding DurationText}" Style="{StaticResource Caption}"
                                          HorizontalAlignment="Right"/>
                            <ui:TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}"
                                          HorizontalAlignment="Right"/>
                            <ui:TextBlock Text="{Binding ExpandHint}" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource Violet}" HorizontalAlignment="Right"
                                          Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Full end-of-game scoreboard -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <Border Height="1" Background="{StaticResource Divider}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="BLUE TEAM" Style="{StaticResource Caption}"
                                              Foreground="{StaticResource Periwinkle}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding BlueTeam}"
                                              ItemTemplate="{StaticResource ScoreboardRowTemplate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="RED TEAM" Style="{StaticResource Caption}"
                                              Foreground="{StaticResource Lilac}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding RedTeam}"
                                              ItemTemplate="{StaticResource ScoreboardRowTemplate}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One player in the live game, laid out like the loading screen -->
        <DataTemplate x:Key="LivePlayerTemplate">
            <Border Margin="5" CornerRadius="8" Padding="10,9" Width="212"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgCard}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
                        <Style.Triggers>
                            <!-- Highlight the local player, as the loading screen does -->
                            <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgCardOn}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource EdgeOn}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="6" Width="48" Height="48" ClipToBounds="True"
                            Background="#191324">
                        <Image Source="{Binding ChampionIcon}" Width="48" Height="48"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center" Width="138">
                        <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong"
                                      Foreground="{StaticResource TextHi}"
                                      TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="{Binding ChampionName}" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource Lilac}"
                                          TextTrimming="CharacterEllipsis"/>
                            <ui:TextBlock Text="{Binding MasteryText}" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource Amber}" Margin="6,0,0,0"
                                          Visibility="{Binding HasMastery, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <ui:TextBlock Text="{Binding RankText}" Style="{StaticResource Caption}"
                                      Foreground="{StaticResource Mint}"
                                      Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}"
                                      TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock Text="{Binding WinRateText}" Style="{StaticResource Caption}"
                                      Visibility="{Binding HasWinRate, Converter={StaticResource BoolToVis}}"
                                      TextTrimming="CharacterEllipsis"/>

                        <ItemsControl ItemsSource="{Binding Spells}" Margin="0,4,0,0"
                                      ItemTemplate="{StaticResource SmallIconTemplate}"
                                      ItemsPanel="{StaticResource RowPanel}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One rune page and its build. Clicking anywhere on the card applies the page. -->
        <DataTemplate x:Key="RunePageTemplate">
            <Border Margin="6,0" CornerRadius="10" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="PageCard_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgCard}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgCardHot}"/>
                                <Setter Property="BorderBrush" Value="#4A3D6B"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgCardOn}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource EdgeOn}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,12,14,10">
                        <Grid>
                            <Border HorizontalAlignment="Left" CornerRadius="4" Padding="7,2"
                                    Background="#3A2F57">
                                <ui:TextBlock Text="{Binding Label}" FontTypography="Caption"
                                              Foreground="{StaticResource VioletLt}"/>
                            </Border>
                            <Border HorizontalAlignment="Right" CornerRadius="4" Padding="7,2"
                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource EdgeOn}">
                                <ui:TextBlock Text="APPLIED" FontTypography="Caption" Foreground="#1B1725"/>
                            </Border>
                        </Grid>

                        <!-- Keystone -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border CornerRadius="24" Background="#191324" Padding="2">
                                <Image Source="{Binding KeystoneIcon}" Width="44" Height="44"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <ui:TextBlock Text="{Binding KeystoneName}" FontTypography="Subtitle"
                                          Foreground="{StaticResource TextHi}" TextWrapping="Wrap"
                                          VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <Border Background="{StaticResource BgInset}" CornerRadius="6"
                                Padding="10,7" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="PICK" Style="{StaticResource Caption}"/>
                                    <ui:TextBlock Text="{Binding PickRateValue}" FontTypography="BodyStrong"
                                                  Foreground="{StaticResource VioletLt}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Text="WIN" Style="{StaticResource Caption}"/>
                                    <ui:TextBlock Text="{Binding WinRateValue}" FontTypography="BodyStrong"
                                                  Foreground="{StaticResource Mint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="GAMES" Style="{StaticResource Caption}"/>
                                    <ui:TextBlock Text="{Binding GamesValue}" FontTypography="BodyStrong"
                                                  Foreground="{StaticResource TextMid}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="14,0,14,0">
                        <!-- Runes -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="{Binding PrimaryTreeIcon}" Width="16" Height="16"/>
                            <ui:TextBlock Text="{Binding PrimaryTreeText}" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource Periwinkle}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PrimaryRunes}" Margin="0,0,0,7"
                                      ItemTemplate="{StaticResource IconTemplate}"
                                      ItemsPanel="{StaticResource RowPanel}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="{Binding SecondaryTreeIcon}" Width="16" Height="16"/>
                            <ui:TextBlock Text="{Binding SecondaryTreeText}" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource Lilac}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SecondaryRunes}" Margin="0,0,0,7"
                                      ItemTemplate="{StaticResource IconTemplate}"
                                      ItemsPanel="{StaticResource RowPanel}"/>

                        <ui:TextBlock Text="SHARDS" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Shards}" Margin="0,0,0,8"
                                      ItemTemplate="{StaticResource SmallIconTemplate}"
                                      ItemsPanel="{StaticResource RowPanel}"/>

                        <Border Height="1" Background="{StaticResource Divider}" Margin="0,0,0,8"/>

                        <!-- Items -->
                        <ui:TextBlock Text="{Binding ItemsNote}" Style="{StaticResource Caption}"
                                      Foreground="{StaticResource Lilac}" TextWrapping="Wrap"
                                      Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding CoreItems}"
                                      ItemTemplate="{StaticResource IconTemplate}"
                                      ItemsPanel="{StaticResource RowPanel}"/>
                        <ui:TextBlock Text="{Binding ItemsWinRateText}" Style="{StaticResource Caption}"
                                      Margin="0,4,0,8"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="70"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <ui:TextBlock Text="STARTERS" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding StarterItems}"
                                              ItemTemplate="{StaticResource SmallIconTemplate}"
                                              ItemsPanel="{StaticResource RowPanel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="BOOTS" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Boots}"
                                              ItemTemplate="{StaticResource SmallIconTemplate}"
                                              ItemsPanel="{StaticResource RowPanel}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding HasSpells, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,9">
                            <ui:TextBlock Text="SUMMONERS" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Spells}"
                                          ItemTemplate="{StaticResource SmallIconTemplate}"
                                          ItemsPanel="{StaticResource RowPanel}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSituational, Converter={StaticResource BoolToVis}}">
                            <ui:TextBlock Text="SITUATIONAL" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Situational}"
                                          ItemTemplate="{StaticResource SmallIconTemplate}"
                                          ItemsPanel="{StaticResource RowPanel}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource BgInset}" CornerRadius="0,0,9,9"
                            Padding="14,6" Margin="0,8,0,0">
                        <Grid>
                            <ui:TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}"
                                          HorizontalAlignment="Left"/>
                            <ui:TextBlock Text="{Binding ActionHint}" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource Violet}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource BgWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar ShowMaximize="True">
                <!-- Wordmark: a badge plus the name, instead of the default plain title -->
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="R" FontSize="21" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EDE4FF" Offset="0"/>
                                    <GradientStop Color="#9F7AEA" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="RONALDO" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#EDE4FF" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- Settings lives beside the wordmark: on the right it never lines up
                             with the caption buttons, which sit higher and are a fixed size. -->
                        <Button x:Name="SettingsBtn" Click="SettingsBtn_Click"
                                Width="30" Height="26" Margin="14,0,0,0"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" VerticalAlignment="Center" ToolTip="Settings">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16"
                                           Foreground="{StaticResource TextLo}"/>
                        </Button>

                        <Button x:Name="ProfileBtn" Click="ProfileBtn_Click"
                                Width="30" Height="26" Margin="2,0,0,0"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" VerticalAlignment="Center" ToolTip="Your profile">
                            <ui:SymbolIcon Symbol="Person24" FontSize="16"
                                           Foreground="{StaticResource TextLo}"/>
                        </Button>
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsBtn}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   HorizontalOffset="0" VerticalOffset="6">
                <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1" Width="300">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel>
                        <ui:TextBlock Text="SETTINGS" Style="{StaticResource Caption}"
                                      Foreground="{StaticResource VioletLt}" Margin="0,0,0,12"/>

                        <ui:ToggleSwitch x:Name="AutoAcceptToggle" Content="Auto-accept queue"
                                         IsChecked="True" Margin="0,0,0,10"/>
                        <ui:ToggleSwitch x:Name="AutoApplyToggle" Content="Auto-apply top rune page"
                                         IsChecked="True" Margin="0,0,0,10"/>
                        <ui:ToggleSwitch x:Name="ItemSetToggle" Content="Import item set in game"
                                         IsChecked="False" Margin="0,0,0,4"/>
                        <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                      Text="Adds the build to your in-game shop and deletes it again once the game ends."
                                      Margin="0,0,0,12"/>

                        <Border Height="1" Background="{StaticResource Divider}" Margin="0,0,0,12"/>
                        <ui:TextBlock x:Name="SettingsStatus" Style="{StaticResource Caption}"
                                      TextWrapping="Wrap" Text=""/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Top bar -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="10"
                BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="16,4,16,12"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock x:Name="HeaderLabel" Text="DETECTED CHAMPION"
                                  Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <ui:TextBlock x:Name="ChampNameText" Text="None (hover a champion)"
                                      FontTypography="Title" Foreground="{StaticResource VioletLt}"/>
                        <Border CornerRadius="4" Padding="7,2" Margin="12,0,0,0"
                                Background="#3A2F57" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="RoleBadge" Text="—" FontTypography="Caption"
                                          Foreground="{StaticResource Lilac}"/>
                        </Border>
                        <ui:TextBlock x:Name="PatchBadge" Text="" FontTypography="Caption"
                                      Foreground="{StaticResource TextLo}" Margin="10,0,0,0"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock x:Name="SourceLine" Text="" Style="{StaticResource Caption}"
                                  Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <ui:TextBlock Text="ROLE" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource GlowBox}">
                            <ComboBox x:Name="LaneCombo" Width="128"
                                      SelectionChanged="Filter_SelectionChanged"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <ui:TextBlock Text="RANK" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource GlowBox}">
                            <ComboBox x:Name="RankCombo" Width="146"
                                      SelectionChanged="Filter_SelectionChanged"/>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <ui:TextBlock Text="REGION" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource GlowBox}">
                            <ComboBox x:Name="RegionCombo" Width="122"
                                      SelectionChanged="Filter_SelectionChanged"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rune pages -->
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PagesList" ItemTemplate="{StaticResource RunePageTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Profile: rank, record and match history.
                 Sits above the other panels so it can overlay whatever is on screen. -->
            <Grid x:Name="ProfilePanel" Visibility="Collapsed" Panel.ZIndex="10"
                  Background="{StaticResource BgWindow}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="10"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        Margin="6,0,6,10" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="28" Width="56" Height="56"
                                ClipToBounds="True" Background="#191324">
                            <Image x:Name="ProfileIcon" Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="ProfileName" Text="—" FontTypography="Title"
                                          Foreground="{StaticResource VioletLt}"/>
                            <ui:TextBlock x:Name="ProfileLevel" Text="" Style="{StaticResource Caption}"
                                          Margin="0,2,0,0"/>

                            <ItemsControl x:Name="RankList" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgInset}" CornerRadius="8"
                                                Padding="12,8" Margin="0,0,10,0" MinWidth="180">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding QueueName}"
                                                              Style="{StaticResource Caption}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <ui:TextBlock Text="{Binding TierText}"
                                                                  FontTypography="BodyStrong"
                                                                  Foreground="{StaticResource TextHi}"/>
                                                    <ui:TextBlock Text="{Binding LpText}"
                                                                  FontTypography="Caption"
                                                                  Foreground="{StaticResource VioletLt}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <ui:TextBlock Text="{Binding RecordText}"
                                                              Style="{StaticResource Caption}"
                                                              Foreground="{StaticResource Mint}"/>
                                                <ui:TextBlock Text="{Binding WinRateText}"
                                                              Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ui:Button Grid.Column="2" Content="Close" Click="ProfileClose_Click"
                                   VerticalAlignment="Top" MinWidth="90"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="6,0,6,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ui:TextBlock Text="MATCH HISTORY" Style="{StaticResource Caption}"
                                          Foreground="{StaticResource VioletLt}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="MatchList" ItemTemplate="{StaticResource MatchTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ui:TextBlock x:Name="ProfileHint" Text="Loading profile..."
                                  FontTypography="Body" Foreground="{StaticResource TextLo}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextWrapping="Wrap" MaxWidth="620" TextAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- In-game scoreboard -->
            <Grid x:Name="InGamePanel" Visibility="Collapsed">
                <Grid.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                         RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#221A38" Offset="0"/>
                        <GradientStop Color="#14111B" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.Background>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:TextBlock Text="YOUR TEAM" Style="{StaticResource Caption}"
                                  Foreground="{StaticResource Periwinkle}"
                                  HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="TeamOneList" ItemTemplate="{StaticResource LivePlayerTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource Divider}" Margin="12,20,12,20"/>

                    <ui:TextBlock Text="ENEMY TEAM" Style="{StaticResource Caption}"
                                  Foreground="{StaticResource Lilac}"
                                  HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="TeamTwoList" ItemTemplate="{StaticResource LivePlayerTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ui:TextBlock x:Name="InGameNote" Text="" Style="{StaticResource Caption}"
                                  HorizontalAlignment="Center" Margin="0,20,0,0"
                                  TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Idle state -->
            <Grid x:Name="IdlePanel" Visibility="Visible">
                <Grid.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45"
                                         RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#241C3A" Offset="0"/>
                        <GradientStop Color="#14111B" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.Background>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Pulsing emblem -->
                    <Grid Width="190" Height="190" HorizontalAlignment="Center">
                        <Ellipse x:Name="PulseRing" Width="190" Height="190" Opacity="0.30">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00000000" Offset="0.55"/>
                                    <GradientStop Color="#9F7AEA" Offset="0.78"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PulseScale" CenterX="95" CenterY="95"
                                                ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.9" To="1.08" Duration="0:0:2.4"/>
                                            <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.9" To="1.08" Duration="0:0:2.4"/>
                                            <DoubleAnimation Storyboard.TargetName="PulseRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.20" To="0.55" Duration="0:0:2.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <ui:TextBlock Text="R" FontSize="76" FontWeight="Bold"
                                      Foreground="{StaticResource VioletLt}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ui:TextBlock x:Name="IdleTitle" Text="Waiting for champion select"
                                  FontTypography="Title" Foreground="{StaticResource TextHi}"
                                  HorizontalAlignment="Center" Margin="0,22,0,0"/>
                    <ui:TextBlock x:Name="IdleSubtitle"
                                  Text="Hover or lock a champion and your builds appear here."
                                  FontTypography="Body" Foreground="{StaticResource TextLo}"
                                  HorizontalAlignment="Center" Margin="0,8,0,0"/>

                    <!-- Active settings at a glance -->
                    <ItemsControl x:Name="IdleChips" Margin="0,22,0,0" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="12,5" Margin="4,0"
                                        Background="#241E36" BorderBrush="{StaticResource Edge}"
                                        BorderThickness="1">
                                    <ui:TextBlock Text="{Binding}" FontTypography="Caption"
                                                  Foreground="{StaticResource TextMid}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}" CornerRadius="10"
                BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="16,12,16,16"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="{StaticResource TextLo}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ui:TextBlock x:Name="StatusText" Text="Waiting for League Client..."
                                  Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>

                <ui:TextBlock Grid.Column="1" x:Name="HintText" Text=""
                              Style="{StaticResource Caption}" VerticalAlignment="Center"
                              HorizontalAlignment="Center" TextWrapping="Wrap"/>

                <ui:Button Grid.Column="2" x:Name="ImportBtn" Content="Re-Import Selected Runes"
                           Click="ImportBtn_Click" MinWidth="200" Visibility="Collapsed"
                           Background="{StaticResource Violet}" Foreground="#17131F"
                           BorderBrush="{StaticResource VioletLt}" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
